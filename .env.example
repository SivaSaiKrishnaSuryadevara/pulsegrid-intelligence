# =====================================================================================
# PulseGrid Intelligence — environment variables
#
# Copy this file to `.env.local` (gitignored) for local development, or set
# these in your Vercel project's Environment Variables settings for deploys.
# Never commit real values — `.env.local` / `.env` are already gitignored.
# =====================================================================================

# ---------------------------------------------------------------------------
# Supabase
# Project Settings -> API in your Supabase dashboard (https://supabase.com/dashboard/project/_/settings/api)
# ---------------------------------------------------------------------------

# Project URL. Public — safe to expose to the browser (NEXT_PUBLIC_ prefix
# required so Next.js inlines it into client bundles).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) API key. Also safe for the browser — every table it can
# reach is still governed by the RLS policies in supabase/migrations/.
# Used by src/lib/supabase/client.ts (browser) and src/lib/supabase/server.ts
# (cookie-bound server client for Server Components and Route Handlers).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER-ONLY — bypasses Row-Level Security entirely.
# NEVER prefix this with NEXT_PUBLIC_ or import it from a Client Component;
# it powers src/lib/supabase/service.ts, used only by Server Components,
# Route Handlers, and scripts (e.g. src/scripts/seed-initial-creators.ts)
# that need to read/write across RLS boundaries deliberately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Upstash Redis (rate limiting)
# Create a Redis database at https://console.upstash.com — the REST URL and
# token are shown on the database's detail page. Optional: if unset,
# src/lib/rate-limit.ts falls back to a per-process in-memory limiter so
# local dev and tests still run — that fallback is NOT correct across
# multiple server instances, so set these for any real deployment.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ---------------------------------------------------------------------------
# Site URL
# Used to build canonical links, OpenGraph URLs, and sitemap entries
# (src/lib/pseo/directory-config.ts). Set to your production domain on
# Vercel; localhost is fine for local development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
